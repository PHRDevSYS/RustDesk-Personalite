# ============================================================================
# PoC Acesso Remoto Afiminas — copie para .env e preencha
# O arquivo .env NUNCA vai para o Git (ver .gitignore)
# ============================================================================

# ---- Identidade / branding (usado só na documentação e no deploy) ----------
COMPANY_NAME=Afiminas
PRODUCT_NAME=AzureDesk
SUPPORT_EMAIL=

# ---- Rede -----------------------------------------------------------------
# Domínio ou IP público do servidor. Durante o PoC pode ser só o IP.
RUSTDESK_DOMAIN=
# O que vai no campo "ID Server" do cliente (host do hbbs).
RUSTDESK_ID_SERVER=
# O que vai no campo "API Server" do cliente.
#   PoC (HTTP direto):  http://SEU_IP:21114
#   Produção (Nginx):   https://SEU_DOMINIO
RUSTDESK_API_SERVER=

# ---- Versões (evitar :latest depois que o PoC validar) ---------------------
# Últimas verificadas em 2026-08-10
RUSTDESK_SERVER_VERSION=1.1.16
RUSTDESK_CLIENT_VERSION=1.4.9
# O console não publica releases tagueadas — só :latest.
# Após o PoC, troque por digest fixo:  ghcr.io/...@sha256:<digest>
CONSOLE_IMAGE=ghcr.io/lantongxue/rustdesk-api-server-pro:latest

# ---- Console: credenciais do admin (SECRET) -------------------------------
# Só têm efeito no PRIMEIRO boot. Depois disso, trocar aqui não muda nada —
# use a UI do console. Não usar admin/test1234 nem qualquer default.
CONSOLE_ADMIN_USER=
CONSOLE_ADMIN_PASS=

# ---- Geral ----------------------------------------------------------------
TZ=America/Sao_Paulo
