# ============================================================================
# AzureControlDesk — ambiente HOMOLOGAÇÃO
# Copie para ambientes/homologacao/.env e preencha. O .env NUNCA vai para o Git.
#
# Este ambiente acompanha a branch `homologacao`: toda alteração validada em
# `main` é promovida para cá e o auto-update a aplica no próximo boot/ciclo.
# ============================================================================

AMBIENTE=homologacao
COMPOSE_PROJECT_NAME=azuredesk-hml

# ---- Identidade / branding ------------------------------------------------
COMPANY_NAME=Afiminas
PRODUCT_NAME=AzureControlDesk
SUPPORT_EMAIL=

# ---- Rede -----------------------------------------------------------------
# Domínio ou IP público do servidor de homologação.
RUSTDESK_DOMAIN=
# O que vai no campo "ID Server" do cliente (host do hbbs).
RUSTDESK_ID_SERVER=
# O que vai no campo "API Server" do cliente.
#   Sem TLS (PoC):     http://SEU_IP:21114
#   Com Nginx/TLS:     https://SEU_DOMINIO
RUSTDESK_API_SERVER=

# ---- Imagens ---------------------------------------------------------------
# Em homologação é aceitável acompanhar tags móveis; em produção, NUNCA.
# O auto-update sobrescreve estes valores com os do release/manifest.json da
# branch deste ambiente — o que estiver aqui é apenas o fallback inicial.
RUSTDESK_SERVER_IMAGE=rustdesk/rustdesk-server:1.1.16
CONSOLE_IMAGE=ghcr.io/lantongxue/rustdesk-api-server-pro:latest

# ---- Console: credenciais do admin (SECRET) -------------------------------
# Só têm efeito no PRIMEIRO boot. Depois disso, trocar aqui não muda nada —
# use a UI do console. Não usar admin/test1234 nem qualquer default.
CONSOLE_ADMIN_USER=
CONSOLE_ADMIN_PASS=

# ---- Geral ----------------------------------------------------------------
TZ=America/Sao_Paulo
