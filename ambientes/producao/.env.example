# ============================================================================
# AzureControlDesk — ambiente PRODUÇÃO
# Copie para ambientes/producao/.env e preencha. O .env NUNCA vai para o Git.
#
# Este ambiente acompanha a branch `producao`: só recebe o que já foi validado
# em homologação. O auto-update aplica a nova versão no próximo boot/ciclo.
# ============================================================================

AMBIENTE=producao
COMPOSE_PROJECT_NAME=azuredesk-prd

# ---- Identidade / branding ------------------------------------------------
COMPANY_NAME=Afiminas
PRODUCT_NAME=AzureControlDesk
SUPPORT_EMAIL=

# ---- Rede -----------------------------------------------------------------
# Domínio ou IP público do servidor de produção.
RUSTDESK_DOMAIN=
# O que vai no campo "ID Server" do cliente (host do hbbs).
RUSTDESK_ID_SERVER=
# O que vai no campo "API Server" do cliente.
#   Produção exige TLS: https://SEU_DOMINIO  (Nginx na 443 -> 21114)
RUSTDESK_API_SERVER=

# ---- Imagens ---------------------------------------------------------------
# PRODUÇÃO: sempre digest fixo (@sha256:...), nunca :latest. O console upstream
# não publica releases tagueadas, então o digest é a única âncora de versão.
# O auto-update sobrescreve estes valores com os do release/manifest.json da
# branch `producao` — o que estiver aqui é apenas o fallback inicial.
RUSTDESK_SERVER_IMAGE=rustdesk/rustdesk-server:1.1.16
CONSOLE_IMAGE=

# ---- Console: credenciais do admin (SECRET) -------------------------------
# Só têm efeito no PRIMEIRO boot. Depois disso, trocar aqui não muda nada —
# use a UI do console. Não usar admin/test1234 nem qualquer default.
CONSOLE_ADMIN_USER=
CONSOLE_ADMIN_PASS=

# ---- Geral ----------------------------------------------------------------
TZ=America/Sao_Paulo
